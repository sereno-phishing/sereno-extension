{
  "manifest_version": 3,
  "name": "Sereno",
  "short_name": "Sereno",
  "version": "0.2.0",
  "minimum_chrome_version": "102",
  "description": "Detecta sitios de phishing mientras navegas y te avisa antes de que ingreses tus datos en tiendas y servicios en línea.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "platform/browser.js",
        "time/domain/time.js",
        "verdict/domain/verdict.js",
        "verdict/domain/outcome.js",
        "ui/atoms.js",
        "verdict/ui/verdict-ui.js",
        "demo-store/ui/verdict-modal.js",
        "verdict/ui/page-overlay.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ui/tokens.css",
        "ui/verdict-modal.css",
        "content/content.css",
        "assets/logo.png",
        "assets/icons/alert-bad-14.svg",
        "assets/icons/alert-bad-44.svg",
        "assets/icons/alert-warn-14.svg",
        "assets/icons/alert-warn-44.svg",
        "assets/icons/toast-pending-32.svg"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "app/admin/admin.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Sereno", "default_popup": "app/popup/popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } }
}
