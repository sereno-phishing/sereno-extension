{
  "manifest_version": 3,
  "name": "Sereno",
  "short_name": "Sereno",
  "version": "0.2.0",
  "minimum_chrome_version": "102",
  "default_locale": "es",
  "description": "__MSG_extensionDescription__",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "background": { "service_worker": "background/service-worker.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "platform/browser.js",
        "platform/storage.js",
        "platform/i18n.js",
        "time/domain/time.js",
        "verdict/domain/verdict.js",
        "verdict/domain/outcome.js",
        "ui/atoms.js",
        "content/content-assets.generated.js",
        "verdict/ui/verdict-ui.js",
        "demo-store/ui/verdict-modal.js",
        "verdict/ui/page-overlay.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "app/admin/admin.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Sereno", "default_popup": "app/popup/popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } }
}
